# Unpublished scripts/ defaults (not shipped in the wheel).
# Consumers: scripts/lib/common.sh and scripts/helpers/defaults.py (same grammar).
# Only the four keys below are real process environment variables (setdefault).
# test_map filename / OBS URL template live as Python constants in defaults.py.
#
# Grammar (both consumers):
#   - empty lines ignored
#   - '#' starts a comment through end of line (including mid-line)
#   - KEY=VALUE; surrounding whitespace stripped; values must not contain '#'

UV_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
HF_ENDPOINT=https://hf-mirror.com
MSMODELING_TEST_BASE_BRANCH=master
MSMODELING_CACHE=.msmodeling_cache

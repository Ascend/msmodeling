        "quantize-linear-action": "W4A8_DYNAMIC",
        "quantize-attention-action": "FP8",
        "quantize-non-expert-linear-action": "W8A8_DYNAMIC"
      }
    },
    "deepseek-ai/DeepSeek-V4-Pro": {
      "description": "DeepSeek-V4-Pro：默认 fused-mc2，量化 W4A8C8",

{
  "name": "msmodeling-web-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "msmodeling Web Console frontend — Vue 3 + Element Plus; forms data-driven, results module-componentized (Constitution Principle II v2.2.0).",
  "scripts": {
    "copy-plugins": "node scripts/copy-plugins.mjs",
    "gen:schemas": "node scripts/gen-form-schemas.mjs",
    "dev": "npm run copy-plugins && npm run gen:schemas && vite",
    "build": "vue-tsc --noEmit && npm run copy-plugins && npm run gen:schemas && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "async-validator": "^4.2.5",
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.4",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.2.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "playwright": "^1.61.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}

# Share intended .vscode config; ignore user-local overrides.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json

# Dev Container host-only Git identity snapshot.
.devcontainer/.host-gitconfig

**/__pycache__
.idea

# Python build/test artifacts ---------------------------------------------------
dist/
*.egg-info/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
# .so native extensions (keep out of the repo)
*.so

# macOS
.DS_Store

# DT coverage report
**/coverage
.coverage*

# Capture/output dumps at repo root only (not model_diagnostics/artifacts package).
/artifacts/

# Local caches / tool installs (not committed)
.msmodeling_cache/
.uv-python/
.venv/

# Local pre-commit binary (downloaded, not committed)
/gitleaks
/gitleaks.exe

# web_ui runtime artifacts (sqlite db, job logs, chrome traces)
.msmodeling_ui/

# web_ui frontend plugins — generated by scripts/copy-plugins.mjs from
# installed plugin packages (npm run copy-plugins); do not commit.
web_ui/frontend/src/plugins/

# web_ui backend var/config — runtime copy of frontend/src/config produced by
# schema_registry.copy_bundled_configs() at startup/frontend build; keep the
# .gitkeep so the dir exists, ignore everything else.
web_ui/backend/var/config/forms/*
!web_ui/backend/var/config/forms/.gitkeep

# web_ui frontend src/config/forms/*.json — generated from the .ts sources by
# scripts/gen-form-schemas.mjs (npm run dev/build); the .ts are the SSOT.
web_ui/frontend/src/config/forms/*.json

# msmodeling-govern local tool state (off-repo tool runtime artifacts)
people.local.yaml

# Template-graph development workspace: internal diagnostic/capture/verification
# scripts and locally-built runtime caches.  Users rebuild caches from their own
# captures; see docs/design/template_graph_target_matrix.md.
/_*.py
/_*.json
/_*.txt
/_cache_nocompile/
/compile_ops_cache_*/
/report.log
govern-state.json
msmodeling-govern-logs/

# Model adaptation working artifacts (doctor/verify reports stay local; only
# code, tests, docs, and optional ST guardrail cases are committed)
reports/

# optix runtime log artifact produced in repo cwd by mindie/ais_bench runs (issue #480)
report.log

# --- OptiX 寻优/压测运行产物与本地备份（不入库）---
.agent_optimizer/
result/
tmp/
case_base_out/
config.pd-*.toml
*.bak
*.bak-*
.codebuddy/

# --- 手工验证轮原始产物（manual_p/d/proxy.sh + bench_raw/ + RESULT.md，5.1MB）---
pd_final_r7/
# Template-graph development workspace: internal diagnostic/capture/verification
# scripts and locally-built runtime caches.  Users rebuild caches from their own
# captures; see docs/design/template_graph_target_matrix.md.
/_*.py
/_*.json
/_*.txt
/_cache_nocompile/
/_structure_switch_evidence/
/_bisect_hold/
/_*.jsonl
/_*_cache/
/_synth_verify_*.py
/_count_infer_scratch/
# Template artifacts stay local EXCEPT the officially verified slim
# registry artifacts that ship with the repository (one per model+compile
# variant; regenerated via template_graph.build_template_graph).
/template_engine/templates/*
!/template_engine/templates/deepseek_v4_pro_cmp_on.json.xz
!/template_engine/templates/glm_5_3_cmp_on.json.xz
!/template_engine/templates/kimi_k3_cmp_on.json.xz
*.defect_backup

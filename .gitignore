# Share intended .vscode config; ignore user-local overrides.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json

# Dev Container host-only Git identity snapshot.
.devcontainer/.host-gitconfig

**/__pycache__
.idea

# Python build/test artifacts ---------------------------------------------------
dist/
*.egg-info/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
# .so native extensions (keep out of the repo)
*.so

# macOS
.DS_Store

# DT coverage report
**/coverage
.coverage*

# Capture/output dumps at repo root only (not model_diagnostics/artifacts package).
/artifacts/

# Local caches / tool installs (not committed)
.msmodeling_cache/
.uv-python/
.venv/

# Local pre-commit binary (downloaded, not committed)
/gitleaks

# web_ui runtime artifacts (sqlite db, job logs, chrome traces)
.msmodeling_ui/

# web_ui frontend plugins — generated by scripts/copy-plugins.mjs from
# installed plugin packages (npm run copy-plugins); do not commit.
web_ui/frontend/src/plugins/

# web_ui backend var/config — runtime copy of frontend/src/config produced by
# schema_registry.copy_bundled_configs() at startup/frontend build; keep the
# .gitkeep so the dir exists, ignore everything else.
web_ui/backend/var/config/forms/*
!web_ui/backend/var/config/forms/.gitkeep

# web_ui frontend src/config/forms/*.json — generated from the .ts sources by
# scripts/gen-form-schemas.mjs (npm run dev/build); the .ts are the SSOT.
web_ui/frontend/src/config/forms/*.json

# msmodeling-govern local tool state (off-repo tool runtime artifacts)
people.local.yaml
govern-state.json
msmodeling-govern-logs/
